# /etc/prepress-hosting.env (root:root 0600)
HOSTING_DOMAIN=prepress.digitalno.de
HOSTING_PORT=8787
S3_BUCKET=prepress
S3_REGION=fr-par
S3_ENDPOINT=https://s3.fr-par.scw.cloud
# Scaleway IAM application "prepress-hosting" (ObjectStorageFullAccess in project "Prepress" only)
S3_ACCESS_KEY=SCW...
S3_SECRET_KEY=...
# Optional quotas
# HOSTING_MAX_SITE_MB=250
# HOSTING_MAX_FILE_MB=25
