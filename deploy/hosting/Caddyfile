# Prepress free hosting — https://<name>.prepress.digitalno.de
#
#   prepress.digitalno.de         → hosting API (127.0.0.1:8787): homepage, /library, /api/*
#   <name>.prepress.digitalno.de  → the bucket folder <name>/ (public-read objects)
#
# Certificates are issued on demand, per site, and only for names the API says
# are claimed (tls-ask), so unknown subdomains never get a certificate.
{
	on_demand_tls {
		ask http://127.0.0.1:8787/api/v1/tls-ask
	}
}

prepress.digitalno.de {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	# Homepage, /library and /api/* are all served by the hosting API.
	reverse_proxy 127.0.0.1:8787
}

*.prepress.digitalno.de {
	tls {
		on_demand
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Clean URLs: /about → /about/ (pages are <slug>/index.html).
	@noslash path_regexp ^(.*/)?[^/.]+$
	redir @noslash {path}/ 308

	# /about/ → /about/index.html, then into the site's folder; drop the query string.
	# (Two `rewrite`s in one block are mutually exclusive in Caddy, hence `uri` for the first step.)
	route {
		uri path_regexp ^(.*)/$ $1/index.html
		rewrite * /{labels.3}{path}?
	}

	reverse_proxy https://prepress.s3.fr-par.scw.cloud {
		header_up Host prepress.s3.fr-par.scw.cloud
		header_down -X-Amz-Request-Id
		header_down -X-Amz-Id-2
		header_down -X-Amz-Version-Id
		header_down -X-Amz-Meta-*
		header_down -Server
		@missing status 403 404
		handle_response @missing {
			rewrite * /api/v1/notfound?site={labels.3}
			reverse_proxy 127.0.0.1:8787
		}
	}
}
